generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── MODELOS ──────────────────────────────────────────────────────────────────
// Enums definidos como String para compatibilidad SQLite/PostgreSQL.
// Ver src/types/index.ts para las definiciones TypeScript de los valores válidos.

// Escalafón — 3 cuerpos: Suboficial (1–8), Oficial (9–18), Técnico (19–26)
// Los civiles (CIVIL_BECARIO, CIVIL_POLICIAL) NO tienen jerarquía
model Rango {
  id        String   @id @default(cuid())
  nombre    String   @unique
  cuerpo    String   // "SUBOFICIAL" | "OFICIAL" | "TECNICO"
  orden     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentes         Agente[]
  historialRangos HistorialRango[]

  @@map("rangos")
}

// Estructura organizacional de la Dirección Monitoreo Cordobeses en Alerta
model Sector {
  id        String   @id @default(cuid())
  nombre    String   @unique
  tipo      String   // TipoSector: "DIRECCION" | "DEPARTAMENTO" | "DIVISION"
  padreId   String?
  padre     Sector?  @relation("SectorJerarquia", fields: [padreId], references: [id])
  hijos     Sector[] @relation("SectorJerarquia")
  agentes   Agente[]
  rolesOrganigrama RolOrganigrama[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sectores")
}

// Nómina del organigrama: quién ocupa cada puesto dentro de un Sector. Puede
// apuntar a un Agente real (rango/nombre se leen de ahí, quedan siempre al
// día) o, si la persona no tiene legajo cargado, guardar rango/nombre sueltos.
model RolOrganigrama {
  id          String   @id @default(cuid())
  sectorId    String
  sector      Sector   @relation(fields: [sectorId], references: [id])
  orden       Int      // posición dentro de la nómina del sector (0 = jefe)
  etiqueta    String   // "Jefe" | "Jefa" | "2°" | "3°" ... texto libre
  agenteId    String?
  agente      Agente?  @relation(fields: [agenteId], references: [id])
  rangoLibre  String?  // usado si agenteId es null
  nombreLibre String?  // usado si agenteId es null
  licencia    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sectorId, orden])
  @@map("roles_organigrama")
}

model Agente {
  id              String   @id @default(cuid())
  cuil            String   @unique

  // Datos personales
  nombres              String
  apellidos            String
  sexo                 String   // "MASCULINO" | "FEMENINO" | "NO_BINARIO" | "PREFIERO_NO_DECIR" | "OTRO"
  sexoPersonalizado    String?  // Texto libre cuando sexo = "OTRO"
  fechaNacimiento      DateTime?
  estadoCivil     String?
  nacionalidad    String?
  provinciaOrigen String?
  ciudadOrigen    String?

  // Datos médicos
  grupoSanguineo       String?
  alergias             String?
  enfermedadesCronicas String?
  medicamentos         String?
  cirugias             String?

  // Familia
  hijosCargo     Int     @default(0)
  poseeSepelio   Boolean @default(false)
  empresaSepelio String?

  // Contacto
  email                       String? @unique
  telefono                    String?
  telefonoAlternativo         String?
  contactoEmergencia          String?  // Nombre/vínculo del contacto
  telefonoContactoEmergencia  String?  // Teléfono del contacto de emergencia

  // Domicilio
  domicilioReal String?
  ciudad        String?
  barrio        String?
  nroDomicilio  String?
  piso          String?

  // Datos laborales
  tipoPersonal String  // TipoPersonal: "SEGURIDAD"|"TECNICO"|"CIVIL_BECARIO"|"CIVIL_POLICIAL"
  estado            String  @default("PENDIENTE") // EstadoAgente: "PENDIENTE"|"ACTIVO"|"BAJA"|"PASE"
  motivoRechazo     String? // Motivo del último rechazo de validación
  fechaIngreso DateTime?
  turno        String?
  // Valores turno: "A"|"B"|"C"|"D"|"E"|"F"|"ADMINISTRATIVO"|"FULL TIME"|"GUARDIA LARGA"|"SUPERIOR DE TURNO"|"PERSONAL INGRESANTE"
  // Editable libremente para cualquier agente, sin importar tipoPersonal/perteneceETAC.
  origenInstitucional         String? // OrigenInstitucional: "GOBIERNO"|"DMCA"|"911"|"OTRA_DEPENDENCIA"
  origenInstitucionalDetalle  String? // Nombre de la dependencia cuando origenInstitucional = "OTRA_DEPENDENCIA"

  // Solo SEGURIDAD y TECNICO
  rangoId       String?
  rango         Rango?   @relation(fields: [rangoId], references: [id])
  anoEgreso     DateTime?
  perteneceETAC Boolean?
  // Marca que el agente está haciendo el curso para ascender de rango; se
  // limpia al confirmar el ascenso (o al cancelarlo). Solo ADMIN/SUPERADMIN
  // la puede setear.
  fechaInicioCursoAscenso DateTime?

  // Solo SEGURIDAD
  tipoArma           String?
  marcaPistola       String?
  modeloPistola      String?
  calibre            String?
  chalecoProvisto    Boolean?
  marcaChaleco       String?
  nroSeriePlacas     String?
  talleChaleco       String?
  vencimientoChaleco DateTime?

  // Situación de revista: Tarea No Operativa (TNO) — arma retenida, pasa a
  // tareas administrativas. Solo aplica a SEGURIDAD.
  enTNO          Boolean?  @default(false)
  motivoTNO      String?
  fechaInicioTNO DateTime?

  // Licencia de conducir
  licenciaConducir    String?
  licenciaEmision     DateTime?
  licenciaVencimiento DateTime?

  // Nivel académico
  nivelPrimario      String?
  nivelSecundario    String?
  nivelTerciario     String?
  nivelUniversitario String?
  nivelSuperior      String?
  detalleTitulos     String?

  fotoUrl  String?

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id])

  usuarioId String?  @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  asistencias         Asistencia[]
  licencias           Licencia[]
  licenciasPendientes LicenciaPendiente[]
  turnoAsignado       TurnoAgente?
  excepciones         ExcepcionTurno[]
  historialRangos     HistorialRango[]
  historialEstados    HistorialEstado[]
  comentarios         Comentario[]
  eventosCursoAscenso EventoCursoAscenso[]
  solicitudesFoto     SolicitudFoto[]
  solicitudesVinculacion SolicitudVinculacion[]
  rolesOrganigrama    RolOrganigrama[]
  diasComoSuperiorTurno DiaTurno[] @relation("SuperiorTurnoDias")
  diasComoJefeFinDe     DiaTurno[] @relation("JefeFinDeDias")
  coberturasTurno       CoberturaTurno[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agentes")
}

model HistorialEstado {
  id             String   @id @default(cuid())
  agenteId       String
  agente         Agente   @relation(fields: [agenteId], references: [id])
  estadoAnterior String
  estadoNuevo    String
  motivo         String?
  usuarioNombre  String?
  createdAt      DateTime @default(now())

  @@map("historial_estados")
}

model Comentario {
  id            String   @id @default(cuid())
  agenteId      String
  agente        Agente   @relation(fields: [agenteId], references: [id])
  texto         String
  usuarioNombre String?
  createdAt     DateTime @default(now())

  @@index([agenteId])
  @@map("comentarios")
}

// Fechas de clases/exámenes de un curso de ascenso (ver
// Agente.fechaInicioCursoAscenso). Quedan como historial permanente aunque
// el curso termine (se confirme o se cancele el ascenso) — no se tocan al
// cerrar el curso, a propósito.
model EventoCursoAscenso {
  id          String   @id @default(cuid())
  agenteId    String
  agente      Agente   @relation(fields: [agenteId], references: [id])
  tipo        String // "CLASE" | "EXAMEN"
  fecha       DateTime
  observacion String?
  createdAt   DateTime @default(now())

  @@index([agenteId])
  @@map("eventos_curso_ascenso")
}

model HistorialRango {
  id          String    @id @default(cuid())
  agenteId    String
  agente      Agente    @relation(fields: [agenteId], references: [id])
  rangoId     String
  rango       Rango     @relation(fields: [rangoId], references: [id])
  fechaDesde  DateTime
  fechaHasta  DateTime?
  observacion String?
  createdAt   DateTime  @default(now())

  @@map("historial_rangos")
}

model Usuario {
  id           String   @id @default(cuid()) // Debe coincidir con Supabase Auth UID
  email        String   @unique
  rol          String   @default("READONLY") // RolUsuario: "SUPERADMIN"|"ADMIN"|"SUPERVISOR"|"OPERADOR"|"READONLY"
  activo       Boolean  @default(true)
  nombre       String?
  apellido     String?
  tipoPersonal String?  // TipoPersonal: igual que en Agente
  jerarquia    String?  // Nombre libre del rango/cargo
  intentosCuil Int      @default(0) // Intentos fallidos de auto-vincular legajo por CUIL en /mi-legajo
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agente            Agente?
  solicitudesEdicion SolicitudEdicion[]
  solicitudesFoto    SolicitudFoto[]
  solicitudesVinculacion SolicitudVinculacion[]
  notificaciones    Notificacion[]

  @@map("usuarios")
}

// Cambiar/sacar la foto de perfil desde /perfil no aplica al toque para
// personal no-admin: queda pendiente de revisión (para que la foto cumpla
// los estándares del legajo) hasta que un admin la apruebe o la rechace.
// Los admins cambian su propia foto directo, sin pasar por acá.
model SolicitudFoto {
  id                String    @id @default(cuid())
  agenteId          String
  agente            Agente    @relation(fields: [agenteId], references: [id])
  usuarioId         String
  usuario           Usuario   @relation(fields: [usuarioId], references: [id])
  tipo              String    // TipoSolicitudFoto: "SUBIR"|"QUITAR"
  fotoUrlPropuesta  String?   // URL pública de la foto a revisión (null si tipo = QUITAR)
  fotoPathPropuesta String?   // Path dentro del bucket, para poder borrarla si se rechaza
  fotoUrlAnterior   String?   // La que tenía el agente al momento de la solicitud (contexto para el admin)
  estado            String    @default("PENDIENTE") // EstadoSolicitudFoto: "PENDIENTE"|"APROBADA"|"RECHAZADA"
  motivoRechazo     String?
  createdAt         DateTime  @default(now())
  revisadoEn        DateTime?

  @@map("solicitudes_foto")
}

// Cuando el registro o el autoservicio en /mi-legajo encuentran un legajo
// candidato (por CUIL, DNI embebido o email) para vincular a una cuenta
// nueva, no se vincula al toque: queda pendiente acá hasta que un admin lo
// confirme. Evita que alcance con saber el DNI de otra persona para acceder
// a su legajo completo (domicilio, salud, familia) apenas registrándose.
model SolicitudVinculacion {
  id            String    @id @default(cuid())
  usuarioId     String
  usuario       Usuario   @relation(fields: [usuarioId], references: [id])
  agenteId      String
  agente        Agente    @relation(fields: [agenteId], references: [id])
  criterio      String    // "CUIL" | "DNI" | "EMAIL"
  estado        String    @default("PENDIENTE") // "PENDIENTE" | "APROBADA" | "RECHAZADA"
  motivoRechazo String?
  createdAt     DateTime  @default(now())
  revisadoEn    DateTime?

  @@map("solicitudes_vinculacion")
}

model Turno {
  id           String   @id @default(cuid())
  nombre       String   @unique
  horaInicio   String?
  horaFin      String?
  diasTrabajo  Int      @default(1)
  diasDescanso Int      @default(0)
  descripcion  String?
  createdAt    DateTime @default(now())

  asignaciones TurnoAgente[]

  @@map("turnos")
}

model TurnoAgente {
  id         String   @id @default(cuid())
  agenteId   String   @unique
  agente     Agente   @relation(fields: [agenteId], references: [id])
  turnoId    String
  turno      Turno    @relation(fields: [turnoId], references: [id])
  fechaDesde DateTime
  createdAt  DateTime @default(now())

  @@map("turnos_agentes")
}

// Calendario mensual de guardias: qué grupo rotativo está en servicio cada día
// (1 = letras A·C·E, 2 = letras B·D·F — las letras y horarios ya están fijos en
// Agente.turno, esto solo define qué grupo trabaja cada día), quién es el
// Superior de Turno (20-8 hs) y quién es el Jefe de Fin de Semana. Un registro
// por día para poder ver el histórico real, igual que Asistencia/HistorialEstado.
model DiaTurno {
  id              String   @id @default(cuid())
  fecha           DateTime @unique
  grupoTurno      Int?     // 1 = A·C·E en servicio, 2 = B·D·F en servicio; null = sin definir
  superiorTurnoId String?
  superiorTurno   Agente?  @relation("SuperiorTurnoDias", fields: [superiorTurnoId], references: [id])
  // Nombre libre, para cuando la persona todavía no tiene legajo cargado —
  // mutuamente excluyente con superiorTurnoId (uno de los dos, nunca ambos).
  superiorTurnoManual String?
  jefeFinDeId     String?
  jefeFinDe       Agente?  @relation("JefeFinDeDias", fields: [jefeFinDeId], references: [id])
  jefeFinDeManual String?
  observacion     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("dias_turno")
}

// Nómina de cobertura fuera de la propia dependencia: Directores/Jefes
// cubriendo otras dependencias de la Policía de Córdoba (tipo JEFATURA, ej.
// "Territorial Este") y personal de menor rango cubriendo lineales de avenida
// (tipo LINEAL). Un solo modelo para los dos casos porque tienen la misma
// forma (agente o nombre libre + fecha/horario + lugar + teléfono) y solo
// difieren en quién es elegible y en el rótulo del campo "lugar" — separarlos
// en dos tablas hubiera duplicado esto sin necesidad. Un registro por franja
// horaria puntual (no por mes entero): las nóminas reales traen un renglón
// por día con su propio horario — entre semana una franja nocturna, los
// fines de semana dos (día y noche).
model CoberturaTurno {
  id           String   @id @default(cuid())
  tipo         String // "JEFATURA" | "LINEAL"
  fecha        DateTime
  horarioDesde String // "HH:MM"
  horarioHasta String // "HH:MM"
  agenteId     String?
  agente       Agente? @relation(fields: [agenteId], references: [id])
  // Nombre (y rango) libre, para cuando la persona todavía no tiene legajo
  // cargado — mutuamente excluyente con agenteId (uno de los dos, nunca ambos).
  nombreManual String?
  lugar        String // dependencia a cubrir (JEFATURA) o avenida (LINEAL)
  // Solo para LINEAL: zona de Córdoba Capital (NORTE/ESTE/SUR/OESTE/CENTRO).
  zona         String?
  telefono     String?
  observacion  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tipo, fecha])
  @@map("coberturas_turno")
}

model ExcepcionTurno {
  id          String   @id @default(cuid())
  agenteId    String
  agente      Agente   @relation(fields: [agenteId], references: [id])
  tipo        String   // TipoExcepcionTurno: "HORA_EXTRA"|"CAMBIO_TURNO"|"GUARDIA_ESPECIAL"
  fecha       DateTime
  horaInicio  String?
  horaFin     String?
  descripcion String?
  aprobadoPor String?
  createdAt   DateTime @default(now())

  @@map("excepciones_turno")
}

// Nota: se usa DateTime en lugar de @db.Date para compatibilidad SQLite/PostgreSQL
model Asistencia {
  id            String   @id @default(cuid())
  agenteId      String
  agente        Agente   @relation(fields: [agenteId], references: [id])
  fecha         DateTime
  estado        String   // EstadoAsistencia: "PRESENTE"|"AUSENTE_JUSTIFICADO"|...
  horaEntrada   DateTime?
  horaSalida    DateTime?
  observacion   String?
  registradoPor String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([agenteId, fecha])
  @@map("asistencias")
}

model Licencia {
  id          String   @id @default(cuid())
  agenteId    String
  agente      Agente   @relation(fields: [agenteId], references: [id])
  tipo        String   // TipoLicencia — ver LICENCIA_TIPOS_POR_CATEGORIA en src/types/index.ts (categorías: Ordinaria, Médica, Extraordinaria, Excepcional, Adscripción)
  estado      String   @default("PENDIENTE") // EstadoLicencia: "PENDIENTE"|"APROBADA"|"RECHAZADA"|"CANCELADA"
  fechaInicio DateTime
  fechaFin    DateTime
  diasHabiles Int
  motivo      String?
  observacion String?
  aprobadoPor String?
  aprobadoEn  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("licencias")
}

// Saldo de días de licencia acumulados/pendientes de usar (licencia anual ordinaria
// de años anteriores, días estímulo por decreto, u otros). El estado (pendiente/
// parcial/usada) se deriva comparando cantidadDias contra la suma de sus usos.
model LicenciaPendiente {
  id              String   @id @default(cuid())
  agenteId        String
  agente          Agente   @relation(fields: [agenteId], references: [id])
  tipo            String   // TipoLicenciaPendiente: "ANUAL_ORDINARIA"|"DIA_ESTIMULO"|"OTRO"
  tipoOtroDetalle String?  // Aclaración libre cuando tipo = "OTRO"
  unidad          String   // UnidadDias: "HABILES"|"CORRIDOS"
  anio            Int
  cantidadDias    Int
  referencia      String?
  usos            UsoLicenciaPendiente[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("licencias_pendientes")
}

// Cada vez que el agente efectivamente toma una parte de un saldo pendiente.
model UsoLicenciaPendiente {
  id                  String            @id @default(cuid())
  licenciaPendienteId String
  licenciaPendiente   LicenciaPendiente @relation(fields: [licenciaPendienteId], references: [id], onDelete: Cascade)
  fecha               DateTime
  cantidadDias        Int
  referencia          String?
  createdAt           DateTime          @default(now())

  @@map("usos_licencia_pendiente")
}

model SolicitudEdicion {
  id             String    @id @default(cuid())
  usuarioId      String
  usuario        Usuario   @relation(fields: [usuarioId], references: [id])
  estado         String    @default("PENDIENTE") // "PENDIENTE" | "APROBADA" | "RECHAZADA"
  motivo         String? // por qué el agente pide editar — opcional, lo escribe él mismo
  motivoRechazo  String?
  permisoHasta   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("solicitudes_edicion")
}

model Notificacion {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  tipo          String   // "SOLICITUD_NUEVA" | "APROBADA" | "RECHAZADA" | "PERMISO_VENCIDO" | "LEGAJO_NUEVO"
  mensaje       String
  referenciaId  String?  // ID del recurso relacionado (agenteId, etc.)
  leida         Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notificaciones")
}

model Feriado {
  id        String   @id @default(cuid())
  fecha     DateTime @unique
  nombre    String
  aplica    Boolean  @default(true) // true = descuenta días hábiles en licencias
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("feriados")
}

model ResetToken {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("reset_tokens")
}

// Confirmación en 3 pasos para eliminar un usuario desde /configuracion/usuarios:
// el código va al mail del admin que pide el borrado (no al del usuario objetivo,
// que puede no tener ya ni cuenta), y queda scopeado a ese par admin/objetivo para
// que no sirva para borrar a otra persona.
model ConfirmacionEliminarUsuario {
  id               String   @id @default(cuid())
  adminId          String
  objetivoId       String
  code             String
  expiresAt        DateTime
  attempts         Int      @default(0) // intentos fallidos del código
  intentosPassword Int      @default(0) // intentos fallidos de contraseña
  verified         Boolean  @default(false) // código verificado, falta la contraseña
  createdAt        DateTime @default(now())

  @@map("confirmaciones_eliminar_usuario")
}

model AuditLog {
  id            String   @id @default(cuid())
  agenteId      String
  usuarioId     String?
  usuarioNombre String?
  seccion       String   // "PERSONAL" | "LABORAL"
  cambios       String   // JSON: [{campo, anterior, nuevo}]
  createdAt     DateTime @default(now())

  @@map("audit_logs")
}
